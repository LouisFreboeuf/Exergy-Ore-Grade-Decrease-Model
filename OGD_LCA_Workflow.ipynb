    "\n",
    "Use the generic search function to find activities by name and location."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "search_example",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Example 1: Generic activity search\n",
    "print('=== Generic Activity Search ===')\n",
    "\n",
    "# Search for electricity activities in Spain\n",
    "electricity_activities = search_activities(\n",
    "    name='electricity',\n",
    "    location='spain',\n",
    "    limit=5\n",
    ")\n",
    "\n",
    "print(f'Found {len(electricity_activities)} electricity activities in Spain:')\n",
    "for i, act in enumerate(electricity_activities):\n",
    "    print(f'  {i+1}. {act.get(\"name\")} - {act.get(\"location\")} - {act.get(\"reference product\")}')"
   ]
